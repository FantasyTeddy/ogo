# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Odroid-Go: 16 MB flash, 4 MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
# Needed on ESP32 revision v1.0 (the chip on this board)
CONFIG_SPIRAM_CACHE_WORKAROUND=y
# The PSRAM self-test adds ~0.9 s to every start
CONFIG_SPIRAM_MEMTEST=n

# Let WiFi and the network stack put buffers into PSRAM; internal RAM is scarce
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# 1 ms scheduler ticks, for steady frame timing in games (the default is 10 ms)
CONFIG_FREERTOS_HZ=1000

# Long filenames on the SD card (the default is 8.3 names only)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Recovery: holding MENU (GPIO13, low when pressed) for 1 s at power-on boots the factory slot.
# That needs otadata cleared; NVS (settings, installed game) is kept.
CONFIG_BOOTLOADER_FACTORY_RESET=y
CONFIG_BOOTLOADER_NUM_PIN_FACTORY_RESET=13
CONFIG_BOOTLOADER_FACTORY_RESET_PIN_LOW=y
CONFIG_BOOTLOADER_OTA_DATA_ERASE=y
CONFIG_BOOTLOADER_DATA_FACTORY_RESET=""
CONFIG_BOOTLOADER_HOLD_TIME_GPIO=1

# Launcher updates: a newly selected app slot must confirm itself
# (esp_ota_mark_app_valid_cancel_rollback), or the next reset boots the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Power management, so games can change the CPU clock at runtime (Ctx::set_cpu_mhz); without a
# configuration it stays at the default 160 MHz
CONFIG_PM_ENABLE=y
